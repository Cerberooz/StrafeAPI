NODE_ENV=production
PORT=5000
HOST=127.0.0.1
# HTTPS runtime: no database password or separate certificate required.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_secret
# Optional direct PostgreSQL mode: omit SUPABASE_URL and configure DATABASE_URL,
# DATABASE_SSL_CA_PATH and DATABASE_POOL_MAX instead.
MAX_IN_FLIGHT_REQUESTS=200
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=120
RATE_LIMIT_MAX_PER_KEY=600
ACCOUNT_SESSION_TTL_SECONDS=180
ACCOUNT_PORTRAIT_CACHE_DIR=/data/account-portraits
ACCOUNT_PUBLIC_URL=https://api.example.com
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
